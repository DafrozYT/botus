# Production Environment Variables for hitmanki.store
# Copy this file to .env and update with your actual production values

# Database Passwords (CHANGE THESE!)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=hitmanki_mongo_secure_2024_!@#
MYSQL_ROOT_PASSWORD=hitmanki_mysql_root_2024_!@#
MYSQL_PASSWORD=hitmanki_mysql_laravel_2024_!@#

# Application Keys (GENERATE NEW ONES!)
JWT_SECRET=hitmanki_jwt_super_secret_production_2024_change_me
SERVER_SEED_SECRET=hitmanki_provably_fair_production_secret_2024
APP_KEY=base64:GENERATE_WITH_ARTISAN_KEY_GENERATE
ADMIN_APP_KEY=base64:GENERATE_WITH_ARTISAN_KEY_GENERATE

# Steam API (REQUIRED)
STEAM_API_KEY=your_actual_steam_api_key_here

# Payment API Keys (UPDATE THESE)
STRIPE_PUBLIC_KEY=pk_live_your_stripe_public_key
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key

# Email Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.yandex.ru
MAIL_PORT=587
MAIL_USERNAME=noreply@hitmanki.store
MAIL_PASSWORD=your_email_password
MAIL_ENCRYPTION=tls

# Analytics (OPTIONAL)
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
YANDEX_METRICA_ID=XXXXXXXX

# Monitoring (OPTIONAL)
ELASTICSEARCH_HOSTS=http://your-elasticsearch-host:9200

# Backup Configuration
BACKUP_S3_BUCKET=hitmanki-backups
BACKUP_S3_ACCESS_KEY=your_s3_access_key
BACKUP_S3_SECRET_KEY=your_s3_secret_key
BACKUP_S3_REGION=eu-west-1

# CDN Configuration (OPTIONAL)
CDN_URL=https://cdn.hitmanki.store
ASSETS_URL=https://cdn.hitmanki.store

# Security
FORCE_HTTPS=true
TRUST_PROXY=true
SESSION_SECURE_COOKIE=true

# Domains
DOMAIN=hitmanki.store
FRONTEND_DOMAIN=hitmanki.store
ADMIN_DOMAIN=admin.hitmanki.store
API_DOMAIN=api.hitmanki.store

# Scaling (OPTIONAL)
REDIS_CLUSTER=false
MONGODB_REPLICA_SET=false

# Monitoring Alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id