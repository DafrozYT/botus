APP_NAME="Hitmanki Cases"
APP_ENV=production
APP_KEY=base64:CHANGEME_GENERATE_WITH_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://hitmanki.store

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=hitmanki_frontend
DB_USERNAME=laravel
DB_PASSWORD=laravelpassword

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_DOMAIN=.hitmanki.store
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@hitmanki.store"
MAIL_FROM_NAME="Hitmanki Cases"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Backend API Configuration
BACKEND_API_URL=https://api.hitmanki.store
BACKEND_WS_URL=wss://api.hitmanki.store

# Steam OAuth (matches backend configuration)
STEAM_API_KEY=your_steam_api_key_here

# Payment Configuration
STRIPE_PUBLIC_KEY=pk_live_your_stripe_public_key
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key

# Site Configuration
SITE_NAME="Hitmanki Cases"
SITE_DESCRIPTION="Открывай кейсы и выигрывай потрясающие предметы!"
SITE_KEYWORDS="кейсы, игры, выигрыш, предметы, hitmanki"
SUPPORT_EMAIL=support@hitmanki.store

# Security
SANCTUM_STATEFUL_DOMAINS=hitmanki.store,admin.hitmanki.store
SESSION_DOMAIN=.hitmanki.store

# SSL Configuration
FORCE_HTTPS=true
ASSET_URL=https://hitmanki.store

# Analytics
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
YANDEX_METRICA_ID=XXXXXXXX