# Server Configuration
PORT=3000
NODE_ENV=production

# Database
MONGODB_URI=mongodb://admin:password123@mongodb:27017/hitmanki_cases?authSource=admin
REDIS_URL=redis://redis:6379

# JWT Configuration
JWT_SECRET=hitmanki_super_secret_jwt_key_2024_production_v1
JWT_EXPIRES_IN=7d

# Steam API Configuration
STEAM_API_KEY=your_steam_api_key_here
STEAM_CALLBACK_URL=https://hitmanki.store/api/auth/steam/callback

# Provably Fair Configuration
SERVER_SEED_SECRET=hitmanki_provably_fair_secret_2024
HOUSE_EDGE=0.05

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
FRONTEND_URL=https://hitmanki.store
ADMIN_URL=https://admin.hitmanki.store

# WebSocket Configuration
WS_CORS_ORIGIN=https://hitmanki.store

# Security
BCRYPT_ROUNDS=12

# Redis Keys Prefix
REDIS_PREFIX=hitmanki:

# API Rate Limits
CASE_OPEN_RATE_LIMIT=10
CASE_OPEN_WINDOW_MS=60000

# Production Security
TRUST_PROXY=true
HELMET_CSP=true

# Domain Configuration
DOMAIN=hitmanki.store
SUBDOMAIN_ADMIN=admin.hitmanki.store