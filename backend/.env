# Server Configuration
PORT=3000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/case-opening
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Steam API Configuration
STEAM_API_KEY=your_steam_api_key_here
STEAM_CALLBACK_URL=http://localhost:3000/api/auth/steam/callback

# Provably Fair Configuration
SERVER_SEED_SECRET=your_server_seed_secret_here
HOUSE_EDGE=0.05

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
FRONTEND_URL=http://localhost:8000
ADMIN_URL=http://localhost:8001

# WebSocket Configuration
WS_CORS_ORIGIN=http://localhost:8000

# Security
BCRYPT_ROUNDS=12

# Redis Keys Prefix
REDIS_PREFIX=case_opening:

# API Rate Limits
CASE_OPEN_RATE_LIMIT=10
CASE_OPEN_WINDOW_MS=60000